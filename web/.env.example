# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez jamais .env.local. En production, les valeurs vont dans Vercel.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : serveur uniquement, jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# API Claude (serveur uniquement)
ANTHROPIC_API_KEY=

# Paiements (mode test d'abord), prestataire à confirmer
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Commission de la plateforme, en points de base (125 = 1,25 %)
TROQLY_COMMISSION_BPS=125
