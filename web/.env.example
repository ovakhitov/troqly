# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez jamais .env.local. En production, les valeurs vont dans Vercel.

# Supabase (Project Settings > Data API et API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_...) : serveur uniquement, ajoutée seulement quand une fonction en aura besoin
SUPABASE_SECRET_KEY=

# API Claude (serveur uniquement)
ANTHROPIC_API_KEY=

# Paiements Stripe Connect, mode test uniquement (sk_test_... ou rk_test_...)
STRIPE_SECRET_KEY=
# Fourni par « stripe listen » en local, ou par le point de terminaison webhook en production
STRIPE_WEBHOOK_SECRET=
# Mettre « oui » seulement au lancement réel, pour autoriser une clé sk_live_
TROQLY_PAIEMENTS_REELS=

# Adresse publique du site (liens des e-mails et retours de paiement)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Commission de la plateforme, en points de base (125 = 1,25 %)
TROQLY_COMMISSION_BPS=125
